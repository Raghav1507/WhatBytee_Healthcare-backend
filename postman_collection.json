{
  "info": {
    "_postman_id": "healthcare-backend-api",
    "name": "Healthcare Backend API",
    "description": "Complete API collection for the Django + DRF + PostgreSQL healthcare backend.\n\n1. Run `POST /api/auth/register/` or `POST /api/auth/login/` first.\n2. Copy the returned `access` token into the collection variable `access_token`.\n3. All other requests send `Authorization: Bearer {{access_token}}` automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "patient_id", "value": "" },
    { "key": "doctor_id", "value": "" },
    { "key": "mapping_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) { console.log('Registered:', body.data.email); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Str0ngPass!23\",\n  \"password2\": \"Str0ngPass!23\",\n  \"phone\": \"+1 555 0100\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.access) {",
                  "    pm.collectionVariables.set('access_token', body.data.access);",
                  "    pm.collectionVariables.set('refresh_token', body.data.refresh);",
                  "    console.log('Token saved to collection variables.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Str0ngPass!23\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/token/refresh/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Me (current user)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "url": "{{base_url}}/api/auth/me/"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/logout/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "2. Patients",
      "item": [
        {
          "name": "Create Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) {",
                  "    pm.collectionVariables.set('patient_id', body.data.id);",
                  "    console.log('Patient ID saved.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/patients/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Patient\",\n  \"age\": 34,\n  \"gender\": \"female\",\n  \"phone\": \"+1 555 2233\",\n  \"email\": \"jane@example.com\",\n  \"address\": \"12 Grove Street\",\n  \"medical_history\": \"Asthma\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "List Patients",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "url": {
              "raw": "{{base_url}}/api/patients/?page=1&page_size=10",
              "host": ["{{base_url}}"],
              "path": ["api", "patients"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "10" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Patient",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "url": "{{base_url}}/api/patients/{{patient_id}}/"
          }
        },
        {
          "name": "Update Patient (PUT)",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/patients/{{patient_id}}/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Updated\",\n  \"age\": 35,\n  \"gender\": \"female\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "url": "{{base_url}}/api/patients/{{patient_id}}/"
          }
        }
      ]
    },
    {
      "name": "3. Doctors",
      "item": [
        {
          "name": "Create Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) {",
                  "    pm.collectionVariables.set('doctor_id', body.data.id);",
                  "    console.log('Doctor ID saved.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/doctors/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah House\",\n  \"specialization\": \"Cardiology\",\n  \"email\": \"s.house@example.com\",\n  \"phone\": \"+1 555 9999\",\n  \"license_number\": \"LIC-9001\",\n  \"years_of_experience\": 14,\n  \"hospital\": \"City General\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "List Doctors",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "url": {
              "raw": "{{base_url}}/api/doctors/?page=1&page_size=10",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "10" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "specialization", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Doctor",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "url": "{{base_url}}/api/doctors/{{doctor_id}}/"
          }
        },
        {
          "name": "Update Doctor (PUT)",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/doctors/{{doctor_id}}/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah House\",\n  \"specialization\": \"Cardiology\",\n  \"license_number\": \"LIC-9001\",\n  \"years_of_experience\": 15\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete Doctor",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "url": "{{base_url}}/api/doctors/{{doctor_id}}/"
          }
        }
      ]
    },
    {
      "name": "4. Patient-Doctor Mappings",
      "item": [
        {
          "name": "Assign Doctor to Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) {",
                  "    pm.collectionVariables.set('mapping_id', body.data.id);",
                  "    console.log('Mapping ID saved.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/mappings/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient\": \"{{patient_id}}\",\n  \"doctor\": \"{{doctor_id}}\",\n  \"notes\": \"Annual check-up\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "List Mappings",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "url": "{{base_url}}/api/mappings/"
          }
        },
        {
          "name": "Get Doctors for Patient",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "url": "{{base_url}}/api/mappings/{{patient_id}}/"
          }
        },
        {
          "name": "Remove Doctor from Patient",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}" }]
            },
            "url": "{{base_url}}/api/mappings/{{mapping_id}}/"
          }
        }
      ]
    }
  ]
}
